# compiled output
/dist
/node_modules
/build
/db

# Migration images - original source files (keep .gitkeep if any)
/img_migrations/**/*.jpg
/img_migrations/**/*.jpeg
/img_migrations/**/*.png
/img_migrations/**/*.gif
/img_migrations/**/*.webp
/img_migrations/**/*.bmp
/img_migrations/**/*.tiff
/img_migrations/**/*.svg

# Public images (keep .gitkeep files)
/public/images/**/*.webp
/public/images/**/*.jpg
/public/images/**/*.jpeg
/public/images/**/*.png
/public/images/**/*.gif
/public/images/**/*.bmp
/public/images/**/*.tiff
/public/images/**/*.svg

# Allow .gitkeep files in public folders
!/public/images/*/.gitkeep

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json