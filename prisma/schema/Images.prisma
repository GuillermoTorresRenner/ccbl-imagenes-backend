model Image {
    id               String   @id @default(cuid())
    title            String?
    altText          String?
    description      String?
    notes            String?
    people           String?
    year             String?
    decade           String?
    zone             String?
    previousData     String?  @map("previous_data")
    patrimonialValue Int?     @map("patrimonial_value")
    owner            String?
    culturalFund     String?  @map("cultural_fund")
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    variants ImageVariant[]

    @@map("images")
}
